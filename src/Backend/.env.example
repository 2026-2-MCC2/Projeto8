# Copie para .env e ajuste os valores
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trocaticket
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# PORT=3000

# Origens autorizadas separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Modo demonstração: não precisa de configuração. Os tokens demo usam um segredo
# aleatório gerado a cada inicialização do servidor (independente do JWT_SECRET).
# JWT_SECRET deve ter 32 caracteres ou mais em produção.
